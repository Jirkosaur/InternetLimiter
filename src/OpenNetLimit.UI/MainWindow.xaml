<Window x:Class="OpenNetLimit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="InternetLimiter" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                    AutomationProperties.Name="Service Status">
            <TextBlock Text="InternetLimiter" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Ellipse Width="10" Height="10" Margin="12,0,4,0"
                     Fill="{Binding StatusColor}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding StatusText}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" SelectionChanged="OnTabChanged">
            <!-- Real-time Tab -->
            <TabItem Header="Real-time">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                                AutomationProperties.Name="Traffic Summary">
                        <TextBlock Margin="0,0,24,0"
                                   AutomationProperties.Name="{Binding TotalDownload, StringFormat='Download speed: {0}'}">
                            <Run Text="Download: " Foreground="{DynamicResource MutedTextBrush}"/>
                            <Run Text="{Binding TotalDownload, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DownloadBrush}"/>
                        </TextBlock>
                        <TextBlock AutomationProperties.Name="{Binding TotalUpload, StringFormat='Upload speed: {0}'}">
                            <Run Text="Upload: " Foreground="{DynamicResource MutedTextBrush}"/>
                            <Run Text="{Binding TotalUpload, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource UploadBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Traffic chart -->
                    <lvc:CartesianChart Grid.Row="1" Margin="0,0,0,8"
                                        Series="{Binding ChartSeries}"
                                        YAxes="{Binding ChartYAxes}"
                                        XAxes="{Binding ChartXAxes}"
                                        AnimationsSpeed="00:00:00.200"
                                        AutomationProperties.Name="Traffic Chart"/>

                    <!-- Process list -->
                    <DataGrid Grid.Row="2" x:Name="ProcessGrid" ItemsSource="{Binding Processes}" Style="{StaticResource DataGridStyle}"
                              AutomationProperties.Name="Process Grid">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Set Bandwidth Limit..." Click="OnSetLimit" IsEnabled="{Binding IsAdmin}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Administrator privileges required"/>
                                <MenuItem Header="Remove Limit" Click="OnRemoveLimit" IsEnabled="{Binding IsAdmin}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Administrator privileges required"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="2*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto"/>
                            <DataGridTextColumn Header="Download/s" Binding="{Binding DownloadDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Upload/s" Binding="{Binding UploadDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Total Down" Binding="{Binding TotalDownDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Total Up" Binding="{Binding TotalUpDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Limit" Binding="{Binding LimitDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History" x:Name="HistoryTab">
                <Grid Margin="0,8,0,0" DataContext="{Binding HistoryViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding ProcessNames}" SelectedItem="{Binding SelectedProcess}"
                                  MinWidth="180" Margin="0,0,12,0"/>
                        <RadioButton Content="Hourly" IsChecked="{Binding IsHourly}"
                                     VerticalAlignment="Center" Margin="0,0,12,0" GroupName="HistoryGranularity"/>
                        <RadioButton Content="Daily" IsChecked="{Binding IsDaily}"
                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                     GroupName="HistoryGranularity"/>
                        <Button Content="Refresh" Click="OnHistoryRefresh" MinWidth="80"/>
                    </StackPanel>

                    <!-- History chart -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding HistorySeries}"
                                        YAxes="{Binding HistoryYAxes}"
                                        XAxes="{Binding HistoryXAxes}"
                                        AnimationsSpeed="00:00:00.300"
                                        AutomationProperties.Name="History Chart"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0"
                   AutomationProperties.Name="Status Bar">
            <StatusBarItem AutomationProperties.Name="{Binding ConnectionsDisplay}">
                <TextBlock Text="{Binding ConnectionsDisplay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem AutomationProperties.Name="{Binding ActiveRulesDisplay}">
                <TextBlock Text="{Binding ActiveRulesDisplay}"/>
            </StatusBarItem>
            <StatusBarItem AutomationProperties.Name="{Binding PermissionModeDisplay}">
                <TextBlock Text="{Binding PermissionModeDisplay}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
